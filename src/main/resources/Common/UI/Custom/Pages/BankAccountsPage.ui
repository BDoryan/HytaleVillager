$C = "../Common.ui";

$C.@PageOverlay {}

$C.@Container {
  Anchor: (Width: 1000, Height: 700);

  #Title {
    Group {
      $C.@Title {
        @Text = "Bank Accounts";
      }
    }
  }

  #Content {
    LayoutMode: Top;

    Group {
      Label #BankName {
        Style: (RenderBold: true);
      }
    }

    Group #AccountList {
      FlexWeight: 1;
      LayoutMode: TopScrolling;
      ScrollbarStyle: $C.@DefaultScrollbarStyle;
    }
  }
}

$C.@BackButton {}
